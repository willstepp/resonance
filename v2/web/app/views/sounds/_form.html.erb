<%= form_for(@sound) do |f| %>
  <% if @sound.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@sound.errors.count, "error") %> prohibited this sound from being saved:</h2>

      <ul>
      <% @sound.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  <table class="form-table">
    <tr>
      <td>
        <%= f.label :name, 'Name' %> :
      </td>
      <td>
        <%= f.text_field :name %>
      </td>
    </tr>
    <tr>
      <td>
        <%= f.label :uuid, 'UUID' %> :
      </td>
      <td>
        <%= f.text_field :uuid %>
      </td>
    </tr>
    <tr>
      <td>
        <%= f.label :description, 'Description' %> :
      </td>
      <td>
        <%= f.text_area :description %>
      </td>
    </tr>
  </table>
  <br>
  <div class="actions">
    <%= f.submit nil, :class => "button highlight-green full-width" %>
  </div>
<% end %>
