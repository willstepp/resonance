<div style="max-width:600px;min-width:400px;margin:0 auto;text-align:right">
  <div style="width:100%;text-align:center">
  <img style="height:35px;float:right" src="/assets/reso-sphere.png"/>
  <img style="height:35px;float:left" src="/assets/reso-title.png"/>
  <div style="clear:both"/>
  </div>
  <div class="panel-container">
      <div>
        <%= link_to '..', root_path, :class => "back-link" %>
      </div>
      <br>
      <h1>Sounds</h1>
      <br><br>
      <div>
        <%= link_to '&nbsp;+&nbsp;'.html_safe, new_sound_path, :class => "button highlight-green" %>
      </div>
      <br>
      <div>
      <% if @sounds.count > 0 %>
        <table>
          <% @sounds.each do |s| %>
            <tr>
              <td><%= link_to s.name, s %></td>
              <td><%= s.uuid %></td>
              <td>
                <%= link_to 'Edit', edit_sound_path(s), :style => "color:lightgray" %>&nbsp;|&nbsp;
                <%= link_to 'Delete', s, method: :delete, :style => "color:#715151", data: { confirm: 'Are you sure?' } %>
              </td>
            </tr>
          <% end %>
        </table>
      <% end %>
    </div>
   
  </div>
</div>