<div style="max-width:600px;min-width:400px;margin:0 auto;text-align:right">
  <div style="width:100%">
  <img style="height:50px;float:right" src="/assets/reso-sphere.png"/>
  <img style="height:50px;float:left" src="/assets/reso-title.png"/>
  <div style="clear:both"/>
  </div>
<div class="panel-container">
  <p id="notice"><%= notice %></p>
  <fieldset>
    <legend><%= @sound.name %></legend>
    <p><%= @sound.description %></p>
    <p><%= @sound.filename %></p>
    <p><%= @sound.filetype %></p>
    <p>Created: <%= @sound.created_at %></p>
    <p>Last Updated: <%= @sound.updated_at %></p>
  </fieldset>

  <%= link_to 'Edit', edit_sound_path(@sound) %> |
  <%= link_to 'Back', sounds_path %>
</div>
</div>
